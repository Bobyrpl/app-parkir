APP_NAME="Aplikasi Parkir"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - default SQLite (sesuai database/database.sqlite di project ini)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# Kalau mau pakai MySQL: ganti DB_CONNECTION=mysql di atas jadi mysql,
# lalu uncomment (hapus #) 5 baris di bawah ini dan sesuaikan:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=db_parkir
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Sanctum - domain frontend yang boleh akses (Bearer token,
# jadi ini sebenarnya cuma dipakai kalau ada bagian yang masih pakai cookie)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# Frontend URL (dipakai untuk CORS allowed_origins di config/cors.php)
FRONTEND_URL=http://localhost:5173

# DANA Bisnis - QRIS MPM (Acquirer), lihat PANDUAN-SETUP.md
DANA_BASE_URL="https://api.sandbox.dana.id"
DANA_IS_PRODUCTION=false
DANA_PARTNER_ID=
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_CHANNEL_ID=
DANA_MERCHANT_ID=
DANA_PRIVATE_KEY_PATH=
DANA_PUBLIC_KEY_PATH=
DANA_ORIGIN="${APP_URL}"
